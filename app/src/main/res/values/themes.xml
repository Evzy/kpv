<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CowsTv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/kpv_bg</item>
        <item name="android:colorBackground">@color/kpv_bg</item>
        <item name="android:statusBarColor">@color/kpv_bg</item>
        <item name="android:navigationBarColor">@color/kpv_bg</item>
        <item name="colorPrimary">@color/kpv_accent</item>
        <item name="mediaRouteTheme">@style/Theme.Kpv.MediaRouterButton</item>
        <item name="castMiniControllerStyle">@style/Kpv.CastMiniController</item>
    </style>

    <style name="Theme.Kpv.MediaRouterButton" parent="Theme.AppCompat">
        <item name="android:windowBackground">@color/kpv_surface</item>
        <item name="colorPrimary">@color/kpv_accent</item>
    </style>

    <style name="Theme.Kpv.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="mediaRouteTheme">@style/Theme.Kpv.MediaRouterButton</item>
    </style>

    <style name="Theme.Kpv.CastControls" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorPrimary">@color/kpv_accent</item>
        <item name="mediaRouteTheme">@style/Theme.Kpv.MediaRouterButton</item>
        <item name="castExpandedControllerStyle">@style/Kpv.CastExpandedController</item>
    </style>

    <style name="Kpv.CastMiniController" parent="CastMiniController">
        <item name="castShowImageThumbnail">false</item>
        <item name="castBackground">@color/kpv_surface</item>
        <item name="castButtonColor">@color/kpv_text_primary</item>
        <item name="castProgressBarColor">@color/kpv_accent</item>
        <item name="castTitleTextAppearance">@style/Kpv.CastMiniTitle</item>
        <item name="castSubtitleTextAppearance">@style/Kpv.CastMiniSubtitle</item>
    </style>

    <style name="Kpv.CastMiniTitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/kpv_text_primary</item>
    </style>

    <style name="Kpv.CastMiniSubtitle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/kpv_text_primary</item>
    </style>

    <style name="Kpv.CastExpandedController" parent="CastExpandedController">
        <item name="castControlButtons">@array/kpv_cast_expanded_buttons</item>
    </style>
</resources>
