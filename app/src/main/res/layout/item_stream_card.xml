<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="176dp"
    android:layout_height="wrap_content"
    android:background="@drawable/stream_card_selector"
    android:focusable="true"
    android:minHeight="202dp"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="99dp">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/kpv_surface_elevated"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/live_indicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/live_indicator_dot"
            android:contentDescription="@null"
            android:elevation="4dp"
            android:visibility="gone" />

        <View
            android:id="@+id/poster_loading_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#8C000000"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/poster_loading_spinner"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/kpv_accent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:ellipsize="end"
        android:gravity="top|start"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:minLines="2"
        android:paddingTop="8dp"
        android:textColor="@color/kpv_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fixture"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:textColor="@color/kpv_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tag"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:textColor="@color/kpv_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
