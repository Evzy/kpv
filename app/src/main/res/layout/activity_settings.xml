<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kpv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:text="@string/settings_title"
            android:textColor="@color/kpv_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/site_origin"
            android:text="@string/site_origin"
            android:textColor="@color/kpv_text_primary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/site_origin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/hint_site"
            android:imeOptions="actionDone|flagNoEnterAction|flagNoFullscreen"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/kpv_text_primary"
            android:textColorHint="@color/kpv_text_secondary" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save_and_reload" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="36dp"
            android:paddingBottom="12dp"
            android:text="@string/settings_app_title"
            android:textColor="@color/kpv_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kpv_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/check_updates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/update_check" />
    </LinearLayout>
</ScrollView>
