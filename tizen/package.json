{
  "name": "kpv-tizen",
  "private": true,
  "type": "module",
  "version": "1.0.33",
  "description": "KPV catalog player for Samsung Tizen TV",
  "scripts": {
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-kpv-icon.ps1",
    "build:flat": "node ./scripts/build-flat.mjs",
    "package": "node ./scripts/build-flat.mjs && node ./scripts/embed-shell-version.mjs && node ./scripts/package-kpv-tizen.mjs",
    "package:local": "npm run icon && npm run package",
    "bundle:web": "node ./scripts/build-web-bundle.mjs",
    "package:hello": "node ./scripts/package-kpv-tizen.mjs --hello",
    "test:embed": "node ./scripts/test-embed-engine.mjs",
    "test:resolve": "node ./scripts/test-stream-resolve.mjs",
    "test:tizen": "node ./scripts/test-stream-resolve.mjs && node ./scripts/test-embed-engine.mjs && node ./scripts/test-stream-live.mjs && node ./scripts/test-bundle-cache-logic.mjs",
    "test:sniff": "node ./scripts/test-embed-engine.mjs && npx --yes serve -l 8766 .",
    "test:play": "npx --yes serve -l 8767 ."
  },
  "dependencies": {
    "hls.js": "^1.5.7",
    "jszip": "^3.10.1"
  }
}
